# Transient pipeline state
.pipeline-state/.orchestrator.lock

# Editor workspace metadata
.obsidian/
.idea/
.vscode/

# OS metadata
.DS_Store
Thumbs.db

# Editor swap files
*.swp
*~

# Python (in case anyone runs scripts in here)
__pycache__/
*.py[cod]

# Pipeline transient sidecars (locks, heartbeats)
.pipeline-state/**/*.lock
.pipeline-state/**/.*.heartbeat

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Raw agent session telemetry: rate_limit_event JSON, session ids, uuids.
# Never useful after the run that produced it, and 182 MB of it reached
# GitHub in Book-KCNA before this rule existed.
**/*.progress.log
