{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0153ofvwRK3arx6ByYkrJhRU","type":"tool_result","content":"1\t\"\"\"Book-outline pipeline stage definitions.\n2\t\n3\tPreview / skeleton. For new books (not yet drafted), this pipeline designs\n4\tthe book-level architecture: chapter lineup, domain-weight allocation,\n5\tcross-chapter retrieval plan, length budget. For already-drafted books, this\n6\tpipeline is not needed.\n7\t\n8\t5 stages total. Gated at the end.\n9\t\"\"\"\n10\t\n11\tfrom __future__ import annotations\n12\t\n13\tfrom dataclasses import dataclass\n14\tfrom typing import Optional\n15\t\n16\t\n17\t@dataclass(frozen=True)\n18\tclass BookStageDefinition:\n19\t    number: int\n20\t    key: str\n21\t    name: str\n22\t    prompt_template: Optional[str]\n23\t    output: str             # relative to book-outline workspace dir\n24\t    framework_files: tuple[str, ...] = ()\n25\t    needs_sources: bool = True\n26\t    gate_key: Optional[str] = None\n27\t\n28\t\n29\tBOOK_STAGES: dict[int, BookStageDefinition] = {\n30\t    1: BookStageDefinition(\n31\t        number=1,\n32\t        key=\"domain_analysis\",\n33\t        name=\"Domain Analysis\",\n34\t        prompt_template=\"B01_domain_analysis.md\",\n35\t        output=\"domain-analysis.md\",\n36\t        framework_files=(\"skill\",),\n37\t        needs_sources=True,\n38\t    ),\n39\t    2: BookStageDefinition(\n40\t        number=2,\n41\t        key=\"chapter_lineup\",\n42\t        name=\"Chapter Lineup\",\n43\t        prompt_template=\"B02_chapter_lineup.md\",\n44\t        output=\"chapter-lineup.md\",\n45\t        framework_files=(\"skill\",),\n46\t        needs_sources=True,\n47\t    ),\n48\t    3: BookStageDefinition(\n49\t        number=3,\n50\t        key=\"retrieval_architecture\",\n51\t        name=\"Retrieval-Practice Architecture\",\n52\t        prompt_template=\"B03_retrieval_architecture.md\",\n53\t        output=\"retrieval-architecture.md\",\n54\t        framework_files=(\"skill\",),\n55\t        needs_sources=False,\n56\t    ),\n57\t    4: BookStageDefinition(\n58\t        number=4,\n59\t        key=\"length_budget\",\n60\t        name=\"Length Budget\",\n61\t        prompt_template=\"B04_length_budget.md\",\n62\t        output=\"length-budget.md\",\n63\t        framework_files=(\"skill\",),\n64\t        needs_sources=False,\n65\t    ),\n66\t    5: BookStageDefinition(\n67\t        number=5,\n68\t        key=\"book_outline_assembly\",\n69\t        name=\"Book Outline Assembly\",\n70\t        prompt_template=\"B05_outline_assembly.md\",\n71\t        output=\"arc-outline.md\",\n72\t        framework_files=(\"skill\", \"structural_contract\", \"branded_terms\"),\n73\t        needs_sources=False,\n74\t        gate_key=\"book_outline_final\",\n75\t    ),\n76\t}\n77\t\n78\t\n79\tBOOK_STAGE_DEPENDENCIES: dict[int, list[int]] = {\n80\t    1: [],\n81\t    2: [1],\n82\t    3: [2],\n83\t    4: [2],\n84\t    5: [3, 4],\n85\t}\n86\t"}]},"parent_tool_use_id":null,"session_id":"46592f22-bd5b-4945-b7f7-384f0a58414e","uuid":"ea3d89ad-8992-497d-82e1-192e3deb96dd","timestamp":"2026-08-24T03:12:39.122Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\dev\\lodestar\\certcomp\\pipeline\\book_stages.py","content":"\"\"\"Book-outline pipeline stage definitions.\n\nPreview / skeleton. For new books (not yet drafted), this pipeline designs\nthe book-level architecture: chapter lineup, domain-weight allocation,\ncross-chapter retrieval plan, length budget. For already-drafted books, this\npipeline is not needed.\n\n5 stages total. Gated at the end.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Optional\n\n\n@dataclass(frozen=True)\nclass BookStageDefinition:\n    number: int\n    key: str\n    name: str\n    prompt_template: Optional[str]\n    output: str             # relative to book-outline workspace dir\n    framework_files: tuple[str, ...] = ()\n    needs_sources: bool = True\n    gate_key: Optional[str] = None\n\n\nBOOK_STAGES: dict[int, BookStageDefinition] = {\n    1: BookStageDefinition(\n        number=1,\n        key=\"domain_analysis\",\n        name=\"Domain Analysis\",\n        prompt_template=\"B01_domain_analysis.md\",\n        output=\"domain-analysis.md\",\n        framework_files=(\"skill\",),\n        needs_sources=True,\n    ),\n    2: BookStageDefinition(\n        number=2,\n        key=\"chapter_lineup\",\n        name=\"Chapter Lineup\",\n        prompt_template=\"B02_chapter_lineup.md\",\n        output=\"chapter-lineup.md\",\n        framework_files=(\"skill\",),\n        needs_sources=True,\n    ),\n    3: BookStageDefinition(\n        number=3,\n        key=\"retrieval_architecture\",\n        name=\"Retrieval-Practice Architecture\",\n        prompt_template=\"B03_retrieval_architecture.md\",\n        output=\"retrieval-architecture.md\",\n        framework_files=(\"skill\",),\n        needs_sources=False,\n    ),\n    4: BookStageDefinition(\n        number=4,\n        key=\"length_budget\",\n        name=\"Length Budget\",\n        prompt_template=\"B04_length_budget.md\",\n        output=\"length-budget.md\",\n        framework_files=(\"skill\",),\n        needs_sources=False,\n    ),\n    5: BookStageDefinition(\n        number=5,\n        key=\"book_outline_assembly\",\n        name=\"Book Outline Assembly\",\n        prompt_template=\"B05_outline_assembly.md\",\n        output=\"arc-outline.md\",\n        framework_files=(\"skill\", \"structural_contract\", \"branded_terms\"),\n        needs_sources=False,\n        gate_key=\"book_outline_final\",\n    ),\n}\n\n\nBOOK_STAGE_DEPENDENCIES: dict[int, list[int]] = {\n    1: [],\n    2: [1],\n    3: [2],\n    4: [2],\n    5: [3, 4],\n}\n","numLines":86,"startLine":1,"totalLines":86}}}
