{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VkHse9prQgZh3m8AtebCJG","type":"tool_result","content":"168\t# ---------------------------------------------------------------------------\n169\t# Voice-swap logic\n170\t# ---------------------------------------------------------------------------\n171\t\n172\t\n173\tdef harvest_research_snapshots(manifest_path: Path, sources_dir: Path) -> list[str]:\n174\t    \"\"\"Stage 2 cannot Write files (stdout is the artifact), so it embeds each snapshot it\n175\t    gathered as a fenced block under a heading naming the target file:\n176\t\n177\t        ### A3 · `lf-mc-exam-faq-2026-08-23.md` (new)\n178\t        ```markdown\n179\t        ---\n180\t        source_url: ...\n181\t        ---\n182\t        ...\n183\t        ```\n184\t\n185\t    Write every such block to {book}/sources/<name>. Blocks whose heading says the file\n186\t    replaces an existing snapshot overwrite it; otherwise existing files are left alone.\n187\t    \"\"\"\n188\t    if not manifest_path.exists():\n189\t        return []\n190\t    text = manifest_path.read_text(encoding=\"utf-8\")\n191\t    pattern = re.compile(\n192\t        r\"^###\\s+[A-Z]?\\d*\\s*[·:\\-]?\\s*`([a-z0-9][a-z0-9._-]*\\.md)`([^\\n]*)\\n\\s*```(?:markdown|md)?\\s*\\n(.*?)\\n```\",\n193\t        re.M | re.S,\n194\t    )\n195\t    written: list[str] = []\n196\t    sources_dir.mkdir(parents=True, exist_ok=True)\n197\t    for name, note, body in pattern.findall(text):\n198\t        if not body.lstrip().startswith(\"---\"):\n199\t            continue  # not a snapshot (frontmatter required)\n200\t        dest = sources_dir / name\n201\t        if dest.exists() and \"replace\" not in note.lower():\n202\t            continue\n203\t        dest.write_text(body.strip() + \"\\n\", encoding=\"utf-8\", newline=\"\\n\")\n204\t        written.append(name)\n205\t    return written\n206\t\n207\t\n208\tdef apply_voice_swap(stage: StageDefinition, chapter_dir: Path) -> None:\n209\t    \"\"\"After a voice-revision stage completes, swap draft-voice.md into the\n210\t    canonical draft-vN.md slot, keeping the pre-voice version as a backup.\n211\t\n212\t    Stage 4 swaps into draft-v1.md (backs up as draft-v1-prevoice.md).\n213\t    Stage 12 swaps into draft-v2.md (backs up as draft-v2-prevoice.md).\n214\t    \"\"\"\n215\t    if stage.key not in (\"voice_1\", \"voice_2\"):\n216\t        return\n217\t\n218\t    voiced = chapter_dir / \"draft-voice.md\"\n219\t    if not voiced.exists():\n220\t        # Voice stage didn't produce output; nothing to swap.\n221\t        return\n222\t"}]},"parent_tool_use_id":null,"session_id":"ccf3f627-6476-4f00-aaf5-561fbd0f1a2c","uuid":"11759745-6903-4886-ad7f-7e864dc8fc3f","timestamp":"2026-08-24T07:09:21.345Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\dev\\lodestar\\certcomp\\pipeline\\orchestrator.py","content":"# ---------------------------------------------------------------------------\n# Voice-swap logic\n# ---------------------------------------------------------------------------\n\n\ndef harvest_research_snapshots(manifest_path: Path, sources_dir: Path) -> list[str]:\n    \"\"\"Stage 2 cannot Write files (stdout is the artifact), so it embeds each snapshot it\n    gathered as a fenced block under a heading naming the target file:\n\n        ### A3 · `lf-mc-exam-faq-2026-08-23.md` (new)\n        ```markdown\n        ---\n        source_url: ...\n        ---\n        ...\n        ```\n\n    Write every such block to {book}/sources/<name>. Blocks whose heading says the file\n    replaces an existing snapshot overwrite it; otherwise existing files are left alone.\n    \"\"\"\n    if not manifest_path.exists():\n        return []\n    text = manifest_path.read_text(encoding=\"utf-8\")\n    pattern = re.compile(\n        r\"^###\\s+[A-Z]?\\d*\\s*[·:\\-]?\\s*`([a-z0-9][a-z0-9._-]*\\.md)`([^\\n]*)\\n\\s*```(?:markdown|md)?\\s*\\n(.*?)\\n```\",\n        re.M | re.S,\n    )\n    written: list[str] = []\n    sources_dir.mkdir(parents=True, exist_ok=True)\n    for name, note, body in pattern.findall(text):\n        if not body.lstrip().startswith(\"---\"):\n            continue  # not a snapshot (frontmatter required)\n        dest = sources_dir / name\n        if dest.exists() and \"replace\" not in note.lower():\n            continue\n        dest.write_text(body.strip() + \"\\n\", encoding=\"utf-8\", newline=\"\\n\")\n        written.append(name)\n    return written\n\n\ndef apply_voice_swap(stage: StageDefinition, chapter_dir: Path) -> None:\n    \"\"\"After a voice-revision stage completes, swap draft-voice.md into the\n    canonical draft-vN.md slot, keeping the pre-voice version as a backup.\n\n    Stage 4 swaps into draft-v1.md (backs up as draft-v1-prevoice.md).\n    Stage 12 swaps into draft-v2.md (backs up as draft-v2-prevoice.md).\n    \"\"\"\n    if stage.key not in (\"voice_1\", \"voice_2\"):\n        return\n\n    voiced = chapter_dir / \"draft-voice.md\"\n    if not voiced.exists():\n        # Voice stage didn't produce output; nothing to swap.\n        return\n","numLines":55,"startLine":168,"totalLines":841}}}
