{"type":"stream_event","event":{"type":"message_delta","delta":{"stop_reason":"tool_use","stop_sequence":null,"stop_details":null},"usage":{"input_tokens":2,"cache_creation_input_tokens":13915,"cache_read_input_tokens":126835,"output_tokens":139,"output_tokens_details":{"thinking_tokens":8},"iterations":[{"input_tokens":2,"output_tokens":139,"cache_read_input_tokens":126835,"cache_creation_input_tokens":13915,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13915},"type":"message"}]},"context_management":{"applied_edits":[]}},"session_id":"d43d99c4-df96-49c9-a0a6-1d65c0997c36","parent_tool_use_id":null,"uuid":"14277815-5333-4a97-a10a-30ad02441a81"}
