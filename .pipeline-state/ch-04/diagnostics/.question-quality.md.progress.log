{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017KfeWHgbDzJR3xUKWeDVj3","type":"tool_result","content":"160\t            shard_path = book_kb / category / f\"{tag_str}.md\"\n161\t            if shard_path.exists():\n162\t                parts.append(f\"\\n===== KB SHARD: {category}/{tag_str} =====\\n\")\n163\t                parts.append(shard_path.read_text(encoding=\"utf-8\"))\n164\t    return \"\".join(parts) if parts else \"[no matching knowledge-base shards found]\"\n165\t\n166\t\n167\t# ---------------------------------------------------------------------------\n168\t# Upstream stage output loading\n169\t# ---------------------------------------------------------------------------\n170\t\n171\t\n172\tUPSTREAM_OUTPUT_KEYS = {\n173\t    \"outline\":            \"outline.md\",\n174\t    \"research_manifest\":  \"research-manifest.md\",\n175\t    \"draft_v1\":           \"draft-v1.md\",\n176\t    \"draft_voice\":        \"draft-voice.md\",\n177\t    \"draft_v2\":           \"draft-v2.md\",\n178\t    \"image_specs\":        \"image-specs.md\",\n179\t    \"integration\":        \"integration.md\",\n180\t}\n181\t\n182\tDIAGNOSTIC_KEYS = {\n183\t    \"structural_audit\":    \"diagnostics/structural.md\",\n184\t    \"fact_audit\":          \"diagnostics/fact-accuracy.md\",\n185\t    \"curriculum_audit\":    \"diagnostics/curriculum-alignment.md\",\n186\t    \"question_audit\":      \"diagnostics/question-quality.md\",\n187\t    \"theming_audit\":       \"diagnostics/theming-density.md\",\n188\t}\n189\t\n190\t\n191\tdef load_chapter_file(chapter_dir: Path, relpath: str) -> str:\n192\t    path = chapter_dir / relpath\n193\t    if not path.exists():\n194\t        return f\"[file not available: {relpath}]\"\n195\t    return path.read_text(encoding=\"utf-8\")\n196\t\n197\t\n198\t# ---------------------------------------------------------------------------\n199\t# The main assembly function\n200\t# ---------------------------------------------------------------------------\n201\t\n202\t\n203\t@dataclass\n204\tclass AssembledPrompt:\n205\t    text: str\n206\t    estimated_tokens: int\n207\t    framework_files_loaded: list[str]\n208\t    substitutions_made: list[str]\n209\t    sources_included: bool\n210\t    kb_shards_included: bool\n211\t\n212\t\n213\tdef assemble_prompt(\n214\t    stage: StageDefinition,\n215\t    book_key: str,\n216\t    chapter_number: int,\n217\t    chapter_dir: Path,\n218\t) -> AssembledPrompt:\n219\t    \"\"\"Build the full prompt for `stage` on the given chapter.\"\"\"\n220\t    if stage.prompt_template is None:\n221\t        raise ValueError(f\"Stage {stage.key} is a native Python stage, not an LLM stage\")\n222\t\n223\t    prompt_path = REPO_ROOT / \"pipeline\" / \"prompts\" / stage.prompt_template\n224\t    if not prompt_path.exists():\n225\t        raise FileNotFoundError(f\"Prompt template not found: {prompt_path}\")\n226\t    template = prompt_path.read_text(encoding=\"utf-8\")\n227\t\n228\t    book = resolve_book(book_key)\n229\t    book_dir = REPO_ROOT / book[\"dir\"]\n230\t\n231\t    substitutions: dict[str, str] = {}\n232\t    subs_made: list[str] = []\n233\t\n234\t    # Framework files\n235\t    framework_loaded: list[str] = []\n236\t    for key in stage.framework_files:\n237\t        substitutions[key] = load_framework_file(key)\n238\t        framework_loaded.append(key)\n239\t\n240\t    # Book metadata\n241\t    substitutions[\"book_key\"] = book_key\n242\t    substitutions[\"book_title\"] = book[\"title\"]\n243\t    substitutions[\"book_exam_code\"] = book[\"exam_code\"]\n244\t    substitutions[\"book_exam_authority\"] = book[\"exam_authority\"]\n245\t    substitutions[\"book_curriculum_version\"] = book[\"curriculum_version\"]\n246\t    substitutions[\"book_dir\"] = str(book_dir)\n247\t\n248\t    # Chapter metadata\n249\t    substitutions[\"chapter_number\"] = str(chapter_number)\n250\t    substitutions[\"chapter_dir\"] = str(chapter_dir)\n251\t\n252\t    # Load outline frontmatter if it exists (used by mention-frequency filter)\n253\t    outline_path = chapter_dir / \"outline.md\"\n254\t    frontmatter: dict = {}\n255\t    if outline_path.exists():\n256\t        _fm, _body = parse_outline_frontmatter(outline_path.read_text(encoding=\"utf-8\"))\n257\t        frontmatter = _fm\n258\t\n259\t    # Upstream stage outputs — load only those referenced in the template.\n260\t    for key, relpath in UPSTREAM_OUTPUT_KEYS.items():\n261\t        marker = \"{{\" + key + \"}}\"\n262\t        if marker in template:\n263\t            substitutions[key] = load_chapter_file(chapter_dir, relpath)\n264\t\n265\t    for key, relpath in DIAGNOSTIC_KEYS.items():\n266\t        marker = \"{{\" + key + \"}}\"\n267\t        if marker in template:\n268\t            substitutions[key] = load_chapter_file(chapter_dir, relpath)\n269\t\n270\t    # Sources\n271\t    sources_included = False\n272\t    if stage.needs_sources:\n273\t        substitutions[\"sources\"] = load_sources_for_book(book_dir)\n274\t        sources_included = True\n275\t\n276\t    # Knowledge-base shards\n277\t    kb_shards_included = False\n278\t    if stage.needs_kb_shards:\n279\t        # If a draft exists, pass it in for mention-frequency filtering.\n280\t        draft_text = \"\"\n281\t        draft_v1 = chapter_dir / \"draft-v1.md\"\n282\t        draft_voice = chapter_dir / \"draft-voice.md\"\n283\t        if draft_voice.exists():\n284\t            draft_text = draft_voice.read_text(encoding=\"utf-8\")\n285\t        elif draft_v1.exists():\n286\t            draft_text = draft_v1.read_text(encoding=\"utf-8\")\n287\t\n288\t        substitutions[\"kb_shards\"] = resolve_kb_shards(book_dir, frontmatter, draft_text)\n289\t        kb_shards_included = True\n290\t\n291\t    # Run substitution. Track only the keys whose marker actually appeared.\n292\t    final = template\n293\t    for key, value in substitutions.items():\n294\t        marker = \"{{\" + key + \"}}\"\n295\t        if marker in final:\n296\t            final = final.replace(marker, value)\n297\t            subs_made.append(key)\n298\t\n299\t    return AssembledPrompt("}]},"parent_tool_use_id":null,"session_id":"f79c78d6-dfaa-4a26-88db-2b1ab3828c08","uuid":"6eda867a-0573-415e-aee4-74658dbf08e8","timestamp":"2026-08-24T09:04:52.378Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\dev\\lodestar\\certcomp\\pipeline\\context_packer.py","content":"            shard_path = book_kb / category / f\"{tag_str}.md\"\n            if shard_path.exists():\n                parts.append(f\"\\n===== KB SHARD: {category}/{tag_str} =====\\n\")\n                parts.append(shard_path.read_text(encoding=\"utf-8\"))\n    return \"\".join(parts) if parts else \"[no matching knowledge-base shards found]\"\n\n\n# ---------------------------------------------------------------------------\n# Upstream stage output loading\n# ---------------------------------------------------------------------------\n\n\nUPSTREAM_OUTPUT_KEYS = {\n    \"outline\":            \"outline.md\",\n    \"research_manifest\":  \"research-manifest.md\",\n    \"draft_v1\":           \"draft-v1.md\",\n    \"draft_voice\":        \"draft-voice.md\",\n    \"draft_v2\":           \"draft-v2.md\",\n    \"image_specs\":        \"image-specs.md\",\n    \"integration\":        \"integration.md\",\n}\n\nDIAGNOSTIC_KEYS = {\n    \"structural_audit\":    \"diagnostics/structural.md\",\n    \"fact_audit\":          \"diagnostics/fact-accuracy.md\",\n    \"curriculum_audit\":    \"diagnostics/curriculum-alignment.md\",\n    \"question_audit\":      \"diagnostics/question-quality.md\",\n    \"theming_audit\":       \"diagnostics/theming-density.md\",\n}\n\n\ndef load_chapter_file(chapter_dir: Path, relpath: str) -> str:\n    path = chapter_dir / relpath\n    if not path.exists():\n        return f\"[file not available: {relpath}]\"\n    return path.read_text(encoding=\"utf-8\")\n\n\n# ---------------------------------------------------------------------------\n# The main assembly function\n# ---------------------------------------------------------------------------\n\n\n@dataclass\nclass AssembledPrompt:\n    text: str\n    estimated_tokens: int\n    framework_files_loaded: list[str]\n    substitutions_made: list[str]\n    sources_included: bool\n    kb_shards_included: bool\n\n\ndef assemble_prompt(\n    stage: StageDefinition,\n    book_key: str,\n    chapter_number: int,\n    chapter_dir: Path,\n) -> AssembledPrompt:\n    \"\"\"Build the full prompt for `stage` on the given chapter.\"\"\"\n    if stage.prompt_template is None:\n        raise ValueError(f\"Stage {stage.key} is a native Python stage, not an LLM stage\")\n\n    prompt_path = REPO_ROOT / \"pipeline\" / \"prompts\" / stage.prompt_template\n    if not prompt_path.exists():\n        raise FileNotFoundError(f\"Prompt template not found: {prompt_path}\")\n    template = prompt_path.read_text(encoding=\"utf-8\")\n\n    book = resolve_book(book_key)\n    book_dir = REPO_ROOT / book[\"dir\"]\n\n    substitutions: dict[str, str] = {}\n    subs_made: list[str] = []\n\n    # Framework files\n    framework_loaded: list[str] = []\n    for key in stage.framework_files:\n        substitutions[key] = load_framework_file(key)\n        framework_loaded.append(key)\n\n    # Book metadata\n    substitutions[\"book_key\"] = book_key\n    substitutions[\"book_title\"] = book[\"title\"]\n    substitutions[\"book_exam_code\"] = book[\"exam_code\"]\n    substitutions[\"book_exam_authority\"] = book[\"exam_authority\"]\n    substitutions[\"book_curriculum_version\"] = book[\"curriculum_version\"]\n    substitutions[\"book_dir\"] = str(book_dir)\n\n    # Chapter metadata\n    substitutions[\"chapter_number\"] = str(chapter_number)\n    substitutions[\"chapter_dir\"] = str(chapter_dir)\n\n    # Load outline frontmatter if it exists (used by mention-frequency filter)\n    outline_path = chapter_dir / \"outline.md\"\n    frontmatter: dict = {}\n    if outline_path.exists():\n        _fm, _body = parse_outline_frontmatter(outline_path.read_text(encoding=\"utf-8\"))\n        frontmatter = _fm\n\n    # Upstream stage outputs — load only those referenced in the template.\n    for key, relpath in UPSTREAM_OUTPUT_KEYS.items():\n        marker = \"{{\" + key + \"}}\"\n        if marker in template:\n            substitutions[key] = load_chapter_file(chapter_dir, relpath)\n\n    for key, relpath in DIAGNOSTIC_KEYS.items():\n        marker = \"{{\" + key + \"}}\"\n        if marker in template:\n            substitutions[key] = load_chapter_file(chapter_dir, relpath)\n\n    # Sources\n    sources_included = False\n    if stage.needs_sources:\n        substitutions[\"sources\"] = load_sources_for_book(book_dir)\n        sources_included = True\n\n    # Knowledge-base shards\n    kb_shards_included = False\n    if stage.needs_kb_shards:\n        # If a draft exists, pass it in for mention-frequency filtering.\n        draft_text = \"\"\n        draft_v1 = chapter_dir / \"draft-v1.md\"\n        draft_voice = chapter_dir / \"draft-voice.md\"\n        if draft_voice.exists():\n            draft_text = draft_voice.read_text(encoding=\"utf-8\")\n        elif draft_v1.exists():\n            draft_text = draft_v1.read_text(encoding=\"utf-8\")\n\n        substitutions[\"kb_shards\"] = resolve_kb_shards(book_dir, frontmatter, draft_text)\n        kb_shards_included = True\n\n    # Run substitution. Track only the keys whose marker actually appeared.\n    final = template\n    for key, value in substitutions.items():\n        marker = \"{{\" + key + \"}}\"\n        if marker in final:\n            final = final.replace(marker, value)\n            subs_made.append(key)\n\n    return AssembledPrompt(","numLines":140,"startLine":160,"totalLines":307}}}
