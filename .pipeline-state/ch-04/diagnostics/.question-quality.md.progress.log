40\t    voiced.rename(canonical)\n241\t\n242\t\n243\t# ---------------------------------------------------------------------------\n244\t# Single-stage execution (LLM or native)\n245\t# ---------------------------------------------------------------------------\n246\t\n247\t\n248\tdef run_native_python_stage(stage: StageDefinition, book_key: str, chapter_num: int) -> tuple[bool, dict]:\n249\t    \"\"\"Dispatch to the right Python tool for non-LLM stages."}]},"parent_tool_use_id":null,"session_id":"f79c78d6-dfaa-4a26-88db-2b1ab3828c08","uuid":"f489418e-0a95-4863-913d-8df7fbab8bbc","timestamp":"2026-08-24T09:05:03.915Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\dev\\lodestar\\certcomp\\pipeline\\orchestrator.py","content":"        dest = sources_dir / name\n        if dest.exists() and \"replace\" not in note.lower():\n            continue\n        dest.write_text(body.strip() + \"\\n\", encoding=\"utf-8\", newline=\"\\n\")\n        written.append(name)\n    return written\n\n\ndef apply_voice_swap(stage: StageDefinition, chapter_dir: Path) -> None:\n    \"\"\"After a voice-revision stage completes, swap draft-voice.md into the\n    canonical draft-vN.md slot, keeping the pre-voice version as a backup.\n\n    Stage 4 swaps into draft-v1.md (backs up as draft-v1-prevoice.md).\n    Stage 12 swaps into draft-v2.md (backs up as draft-v2-prevoice.md).\n    \"\"\"\n    if stage.key not in (\"voice_1\", \"voice_2\"):\n        return\n\n    voiced = chapter_dir / \"draft-voice.md\"\n    if not voiced.exists():\n        # Voice stage didn't produce output; nothing to swap.\n        return\n\n    if stage.key == \"voice_1\":\n        canonical = chapter_dir / \"draft-v1.md\"\n        backup = chapter_dir / \"draft-v1-prevoice.md\"\n    else:  # voice_2\n        canonical = chapter_dir / \"draft-v2.md\"\n        backup = chapter_dir / \"draft-v2-prevoice.md\"\n\n    # First voice run: preserve the un-voiced draft as the backup.\n    # Subsequent voice runs (e.g., retroactive --preset voice): the un-voiced\n    # baseline backup already exists and stays put. The new voiced draft\n    # replaces the previously-voiced canonical (we lose the prior voiced\n    # version, but the pre-voice baseline is preserved across all reruns).\n    if canonical.exists() and not backup.exists():\n        canonical.rename(backup)\n    elif canonical.exists():\n        canonical.unlink()\n\n    voiced.rename(canonical)\n\n\n# ---------------------------------------------------------------------------\n# Single-stage execution (LLM or native)\n# ---------------------------------------------------------------------------\n\n\ndef run_native_python_stage(stage: StageDefinition, book_key: str, chapter_num: int) -> tuple[bool, dict]:\n    \"\"\"Dispatch to the right Python tool for non-LLM stages.","numLines":50,"startLine":200,"totalLines":844}}}
