{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013g6vFxNBD2BfTe5RLi7zxu","type":"tool_result","content":"330\t    stage = get_stage(stage_num)\n331\t    ch = state.chapters.setdefault(chapter_num, ChapterState(number=chapter_num))\n332\t\n333\t    if not skip_dep_check:\n334\t        for dep in STAGE_DEPENDENCIES.get(stage_num, []):\n335\t            dep_rec = ch.stages.get(dep)\n336\t            if not dep_rec or dep_rec.status not in (\"completed\", \"skipped\", \"adopted\"):\n337\t                msg = f\"stage {stage_num} depends on stage {dep}, which is not satisfied.\"\n338\t                print(f\"ERROR: {msg}\", file=sys.stderr)\n339\t                logger.stage_end(chapter_num, stage_num, stage.key,\n340\t                                 status=\"failed\", duration_seconds=0, error=msg)\n341\t                return False\n342\t\n343\t    logger.stage_start(chapter_num, stage_num, stage.key)\n344\t    started = time.monotonic()\n345\t    ch.stages[stage_num] = StageRecord(status=\"in_progress\", started_at=now_iso())\n346\t\n347\t    error: Optional[str] = None\n348\t    meta: dict = {}\n349\t    ok = False\n350\t    try:\n351\t        if stage.is_llm_stage:\n352\t            ok, meta, error = run_llm_stage(stage, book_key, chapter_num)\n353\t        else:\n354\t            ok, meta = run_native_python_stage(stage, book_key, chapter_num)\n355\t    except Exception as e:\n356\t        ok = False\n357\t        error = repr(e)\n358\t        ch.stages[stage_num].error = error\n359\t\n360\t    duration = time.monotonic() - started\n361\t    rec = ch.stages[stage_num]\n362\t    rec.completed_at = now_iso()\n363\t    rec.status = \"completed\" if ok else \"failed\"\n364\t    rec.duration_seconds = duration\n365\t    rec.prompt_tokens_est = meta.get(\"prompt_tokens_est\")\n366\t    rec.model_id = meta.get(\"model_id\")\n367\t    rec.error = error\n368\t\n369\t    book_dir = resolve_book_dir(book_key)\n370\t    ch_dir = chapter_dir_for(book_dir, chapter_num)\n371\t    rec.output_path = str(stage_output_path(stage, ch_dir))\n372\t\n373\t    # Voice-swap after successful voice stages.\n374\t    if ok and stage.key in (\"voice_1\", \"voice_2\"):\n375\t        try:\n376\t            apply_voice_swap(stage, ch_dir)\n377\t            if stage.key in (\"voice_1\", \"voice_2\"):\n378\t                # The voiced text now lives in the canonical slot; record that, not draft-voice.md,\n379\t                # so downstream diagnostics are handed a file that exists.\n380\t                rec.output_path = str(ch_dir / (\"draft-v1.md\" if stage.key == \"voice_1\" else \"draft-v2.md\"))\n381\t        except OSError as e:\n382\t            print(f\"WARN: voice swap failed: {e}\", file=sys.stderr)\n383\t    if ok and stage.key == \"research\":\n384\t        try:\n385\t            harvested = harvest_research_snapshots(ch_dir / \"research-manifest.md\", resolve_book_dir(book_key) / \"sources\")\n386\t            if harvested:\n387\t                print(f\"  harvested {len(harvested)} source snapshot(s) from research-manifest.md\", file=sys.stderr)\n388\t        except OSError as e:\n389\t            print(f\"WARN: snapshot harvest failed: {e}\", file=sys.stderr)\n390\t\n391\t    logger.stage_end(\n392\t        chapter_num, stage_num, stage.key,\n393\t        status=rec.status,\n394\t        duration_seconds=duration,\n395\t        model_id=rec.model_id,\n396\t        prompt_tokens_est=rec.prompt_tokens_est,\n397\t        retries=meta.get(\"retries\"),\n398\t        error=error,\n399\t    )"}]},"parent_tool_use_id":null,"session_id":"342615ce-b30a-4872-b386-6c295bf0fb52","uuid":"00364574-f01e-4395-8e01-960080bf03a8","timestamp":"2026-08-24T09:07:31.029Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\dev\\lodestar\\certcomp\\pipeline\\orchestrator.py","content":"    stage = get_stage(stage_num)\n    ch = state.chapters.setdefault(chapter_num, ChapterState(number=chapter_num))\n\n    if not skip_dep_check:\n        for dep in STAGE_DEPENDENCIES.get(stage_num, []):\n            dep_rec = ch.stages.get(dep)\n            if not dep_rec or dep_rec.status not in (\"completed\", \"skipped\", \"adopted\"):\n                msg = f\"stage {stage_num} depends on stage {dep}, which is not satisfied.\"\n                print(f\"ERROR: {msg}\", file=sys.stderr)\n                logger.stage_end(chapter_num, stage_num, stage.key,\n                                 status=\"failed\", duration_seconds=0, error=msg)\n                return False\n\n    logger.stage_start(chapter_num, stage_num, stage.key)\n    started = time.monotonic()\n    ch.stages[stage_num] = StageRecord(status=\"in_progress\", started_at=now_iso())\n\n    error: Optional[str] = None\n    meta: dict = {}\n    ok = False\n    try:\n        if stage.is_llm_stage:\n            ok, meta, error = run_llm_stage(stage, book_key, chapter_num)\n        else:\n            ok, meta = run_native_python_stage(stage, book_key, chapter_num)\n    except Exception as e:\n        ok = False\n        error = repr(e)\n        ch.stages[stage_num].error = error\n\n    duration = time.monotonic() - started\n    rec = ch.stages[stage_num]\n    rec.completed_at = now_iso()\n    rec.status = \"completed\" if ok else \"failed\"\n    rec.duration_seconds = duration\n    rec.prompt_tokens_est = meta.get(\"prompt_tokens_est\")\n    rec.model_id = meta.get(\"model_id\")\n    rec.error = error\n\n    book_dir = resolve_book_dir(book_key)\n    ch_dir = chapter_dir_for(book_dir, chapter_num)\n    rec.output_path = str(stage_output_path(stage, ch_dir))\n\n    # Voice-swap after successful voice stages.\n    if ok and stage.key in (\"voice_1\", \"voice_2\"):\n        try:\n            apply_voice_swap(stage, ch_dir)\n            if stage.key in (\"voice_1\", \"voice_2\"):\n                # The voiced text now lives in the canonical slot; record that, not draft-voice.md,\n                # so downstream diagnostics are handed a file that exists.\n                rec.output_path = str(ch_dir / (\"draft-v1.md\" if stage.key == \"voice_1\" else \"draft-v2.md\"))\n        except OSError as e:\n            print(f\"WARN: voice swap failed: {e}\", file=sys.stderr)\n    if ok and stage.key == \"research\":\n        try:\n            harvested = harvest_research_snapshots(ch_dir / \"research-manifest.md\", resolve_book_dir(book_key) / \"sources\")\n            if harvested:\n                print(f\"  harvested {len(harvested)} source snapshot(s) from research-manifest.md\", file=sys.stderr)\n        except OSError as e:\n            print(f\"WARN: snapshot harvest failed: {e}\", file=sys.stderr)\n\n    logger.stage_end(\n        chapter_num, stage_num, stage.key,\n        status=rec.status,\n        duration_seconds=duration,\n        model_id=rec.model_id,\n        prompt_tokens_est=rec.prompt_tokens_est,\n        retries=meta.get(\"retries\"),\n        error=error,\n    )","numLines":70,"startLine":330,"totalLines":844}}}
