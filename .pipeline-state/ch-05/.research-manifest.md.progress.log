{"type":"stream_event","event":{"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"upled. In non-cloud contexts, applications executed on the same physical or virtual machine are analogous to cloud applications executed on the same logical host.\n\nAs well as application containers, a Pod can contain init containers that run during"}},"session_id":"2f4e90d3-770b-4003-9277-b785773091db","parent_tool_use_id":null,"uuid":"72a2789e-e24c-4af7-9281-1bfbc98304e9"}
