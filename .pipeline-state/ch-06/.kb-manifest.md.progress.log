{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M9KUwS4FsZaB2RpWsRKPR9","type":"tool_result","content":"1\t---\n2\tchapter: 6\n3\tchapter_type: \"content\"\n4\ttitle: \"Fleets, Not Vessels\"\n5\tsubtitle: \"Nobody sails one Pod\"\n6\texam_domain: \"Kubernetes Fundamentals (competency: Kubernetes Core Concepts)\"\n7\tdomain_weight_pct: 6\n8\tcomplexity: \"mixed\"\n9\tnovelty: \"moderate\"\n10\tprereq_factor: \"standard\"\n11\t\n12\t#-- Section plan (no word budgets) ---------------------------------------\n13\t#-- Length is content-driven. Arc-outline depth band for this chapter:\n14\t#-- \"standard-plus\" - 6 points, but this is the control loop's first\n15\t#-- instantiation and it closes Part II's trunk. Planning signal only,\n16\t#-- NOT a target.\n17\t#--\n18\t#-- WARNING - SECTION NUMBERING IS CONTESTED. Seven published cross-bearings\n19\t#-- point into this chapter. Five agree; three collide on the same number.\n20\t#--   chapter-04 line 269  -> *[see Ch 6 §1 - Deployments and ReplicaSets]*\n21\t#--   chapter-05 line 553  -> *[see Ch 6 §1 - the resource that holds the surviving intent]*\n22\t#--   chapter-05 line 1455 -> *[see Ch 6 §1 - Deployments, ReplicaSets, and the Pod template]*\n23\t#--   chapter-05 line 860  -> *[see Ch 6 §4 - what makes a rolling update safe]*\n24\t#--   chapter-04 line 688  -> *[see Ch 6 §3 - a controller's selector and the Pods it owns]*\n25\t#--   chapter-01 line 435  -> *[see Ch 6 §3 - StatefulSets and stable identity]*   <-- COLLIDES\n26\t#--   chapter-02 line 600  -> *[see Ch 6 §3 - CRDs and extending the API]*         <-- COLLIDES\n27\t#-- §1, §3 and §4 below honor the first five. The two collisions cannot be\n28\t#-- honored by any numbering; they require a two-token edit in shipped text.\n29\t#-- See § Open questions #1 for the exact edits and the reasoning.\n30\t#-- Do not renumber without re-checking all seven.\n31\tsections:\n32\t  - name: \"The Resource That Holds the Intent\"\n33\t    objectives: [\"D1.1\"]\n34\t    requires_figure: true\n35\t    figure_anchor: \"ch06-fig01-deployment-replicaset-pod-ownership\"\n36\t    checkpoint_after: false\n37\t  - name: \"A Loop You Can Watch Working\"\n38\t    objectives: [\"D1.1\"]\n39\t    requires_figure: false\n40\t    figure_anchor: null\n41\t    checkpoint_after: false\n42\t  - name: \"How a Controller Knows Its Own\"\n43\t    objectives: [\"D1.1\"]\n44\t    requires_figure: false\n45\t    figure_anchor: null\n46\t    checkpoint_after: true\n47\t  - name: \"Changing the Fleet Under Way\"\n48\t    objectives: [\"D1.1\"]\n49\t    requires_figure: true\n50\t    figure_anchor: \"ch06-fig02-rolling-update-maxsurge-maxunavailable\"\n51\t    checkpoint_after: false\n52\t  #-- §4 also carries ch06-fig03-recreate-vs-rolling. The schema allows one\n53\t  #-- anchor per section; both are specified in § Required figures and both\n54\t  #-- appear in figures_planned. Do not drop fig03 on a schema technicality.\n55\t  - name: \"Every Rollout Is a Revision\"\n56\t    objectives: [\"D1.1\"]\n57\t    requires_figure: false\n58\t    figure_anchor: null\n59\t    checkpoint_after: true\n60\t  - name: \"When Pods Are Not Interchangeable\"\n61\t    objectives: [\"D1.1\"]\n62\t    requires_figure: true\n63\t    figure_anchor: \"ch06-fig05-statefulset-vs-deployment-identity\"\n64\t    checkpoint_after: false\n65\t  - name: \"One Per Node, and Work That Ends\"\n66\t    objectives: [\"D1.1\"]\n67\t    requires_figure: true\n68\t    figure_anchor: \"ch06-fig04-workload-resource-decision-tree\"\n69\t    checkpoint_after: false\n70\t  - name: \"The Control Loop, Extended\"\n71\t    objectives: [\"D1.1\"]\n72\t    requires_figure: false\n73\t    figure_anchor: null\n74\t    checkpoint_after: true\n75\t  - name: \"Nobody Sails One Pod\"\n76\t    objectives: [\"D1.1\"]\n77\t    requires_figure: true\n78\t    figure_anchor: \"ch06-zenith-control-loop-instantiated\"\n79\t    checkpoint_after: false\n80\t\n81\t#-- Nine sections, matching Chapt