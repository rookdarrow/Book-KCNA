{"type":"stream_event","event":{"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"\n\n## Measuring resource usage\n\n### CPU\n\n> \"CPU is reported as the average core usage measured in cpu units. One cpu, in Kubernetes, is equivalent to 1 vCPU/"}},"session_id":"e4cae61e-42df-484d-af84-1dcbf8c0a281","parent_tool_use_id":null,"uuid":"ff29acf9-a1ae-4530-b6fa-761f57ce3c39"}
