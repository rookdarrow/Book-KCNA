{"type":"stream_event","event":{"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"\n\n> \"For Kubernetes, the *Metrics API* offers a basic set of metrics to support automatic scaling and similar use cases. This API makes information available about resource usage for node and pod, including metrics for CPU and mem"}},"session_id":"e4cae61e-42df-484d-af84-1dcbf8c0a281","parent_tool_use_id":null,"uuid":"36b9777b-2d8f-4027-88f4-e59e655ec64e"}
