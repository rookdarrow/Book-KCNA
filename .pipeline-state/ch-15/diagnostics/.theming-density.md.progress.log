{"type":"stream_event","event":{"type":"message_delta","delta":{"stop_reason":"tool_use","stop_sequence":null,"stop_details":null},"usage":{"input_tokens":2,"cache_creation_input_tokens":16403,"cache_read_input_tokens":105547,"output_tokens":139,"output_tokens_details":{"thinking_tokens":8},"iterations":[{"input_tokens":2,"output_tokens":139,"cache_read_input_tokens":105547,"cache_creation_input_tokens":16403,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16403},"type":"message"}]},"context_management":{"applied_edits":[]}},"session_id":"aed3b9c8-f52f-4b69-8d2d-4a162e17f409","parent_tool_use_id":null,"uuid":"8be1dcb8-8332-42cc-bb6f-bd009e9d5b26"}
