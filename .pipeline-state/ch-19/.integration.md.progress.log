efault.{0,40}IngressClass|IngressClass.{0,40}default|two default|second default|more than one default\" chapter-10-traffic-from-beyond-the-cluster.md | head -6\necho; echo \"=== Ch17: waypoint ===\"; grep -nic \"waypoint\" chapter-17-the-fleet-and-its-charts.md\necho \"=== Ch17: ambient mode vs mesh ===\"; grep -oiE \"ambient (mode|mesh)\" chapter-17-the-fleet-and-its-charts.md | sort | uniq -c\necho \"=== Ch17: SIG Node/Network/Storage named? ===\"; grep -noiE \"SIG (Node|Network|Storage|Release|Architecture)\" chapter-17-the-fleet-and-its-charts.md | sort -t: -k2 | uniq -c -f0 | head\necho \"=== Ch17: TAG rename origin ===\"; grep -niE \"later to be renamed|renamed.{0,30}Technical Advisory\" chapter-17-the-fleet-and-its-charts.md | head -3\necho; echo \"=== Ch18: SLA present? ===\"; grep -nc \"SLA\" chapter-18-reading-the-instruments.md\necho \"=== Ch11: storageClassName empty-string ===\"; grep -nc 'storageClassName: \"\"' chapter-11-below-the-waterline.md\necho \"=== Ch5/Ch6: restartPolicy Never in Deployment ===\"; grep -niE \"restartPolicy.{0,60}(Always|Never)\" chapter-05-the-smallest-vessel.md chapter-06-fleets-not-vessels.md | head -5","description":"Verify §2 claims are taught in owning chapters"}},{"tool_name":"Bash","tool_use_id":"toolu_01DFA9zcLPRk2fjYbRMft4vh","tool_input":{"command":"ls /c/dev/lodestar/Book-KCNA/sources/ | wc -l; echo \"--- files in ch19 research manifest ---\"; grep -ohE \"^\\| ?\\`?[a-z0-9-]+-2026-[0-9-]+\\`?\" /c/dev/lodestar/Book-KCNA/.pipeline-state/ch-19/research-manifest.md 2>/dev/null | wc -l","description":"Count corpus size vs chapter manifest"}},{"tool_name":"Bash","tool_use_id":"toolu_01BBPKyeoTBP7Aorf7baHkzY","tool_input":{"command":"D=/c/dev/lodestar/Book-KCNA/.pipeline-state/ch-19/draft-v2.md; for p in 'cloud-native' 'ArgoCD' 'Kubelet' 'Stateful Set' 'Network Policy' 'Service Account' 'ambient mesh' 'Road Ahead' 'Landfall' 'Shoals'; do printf '%-16s %s\\n' \"$p\" \"$(grep -c -- \"$p\" $D)\"; done","description":"Precise